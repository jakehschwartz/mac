DISABLE_AUTO_UPDATE="true"
DISABLE_MAGIC_FUNCTIONS="true"
DISABLE_COMPFIX="true"
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE="20"
ZSH_AUTOSUGGEST_USE_ASYNC=1

if [[ -z "$HOMEBREW_PREFIX" ]]; then
    export HOMEBREW_PREFIX=$(brew --prefix)
fi
export PATH=$HOMEBREW_PREFIX/opt/python@3.14/libexec/bin:/usr/local/sbin:$PATH

alias python="python3"
alias json="pbpaste | jq -C \".\""
alias jsonout="pbpaste | jq \".\""
alias cj="jq -C \".\""

alias utc='zdump UTC'
alias brewup='brew update; brew upgrade; brew prune; brew cleanup; brew doctor'
alias mux='tmuxinator'

export CLAUDE_CODE_MAX_OUTPUT_TOKENS=16000
export MAX_THINKING_TOKENS=1024
export AWS_PROFILE="Google-PlatformEng"
export CLAUDE_CODE_USE_BEDROCK=1
export AWS_DEFAULT_REGION=us-west-2
export ANTHROPIC_MODEL='arn:aws:bedrock:us-west-2:121286554335:application-inference-profile/amsoyjbjv623'
export ANTHROPIC_DEFAULT_HAIKU_MODEL='arn:aws:bedrock:us-west-2:121286554335:application-inference-profile/0ls7cm40jo4m'
export CLAUDE_CODE_MAX_OUTPUT_TOKENS=16000
export MAX_THINKING_TOKENS=1024

export ANTIDOTE_HOME=~/.cache/antidote
source $(brew --prefix)/opt/antidote/share/antidote/antidote.zsh
source <(antidote init)

antidote bundle getantidote/use-omz
antidote bundle ohmyzsh/ohmyzsh path:lib
antidote bundle ohmyzsh/ohmyzsh path:plugins/git
antidote bundle ohmyzsh/ohmyzsh path:plugins/1password
antidote bundle ohmyzsh/ohmyzsh path:plugins/autojump
antidote bundle ohmyzsh/ohmyzsh path:plugins/thefuck
antidote bundle MichaelAquilina/zsh-autoswitch-virtualenv


# Syntax highlighting bundle.
antidote bundle zsh-users/zsh-syntax-highlighting

# Fish-like auto suggestions
antidote bundle zsh-users/zsh-autosuggestions

# Extra zsh completions
antidote bundle zsh-users/zsh-completions

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

export EDITOR=$HOMEBREW_PREFIX/bin/vim

#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

eval $(thefuck --alias)

# The following lines were added by compinstall
zstyle :compinstall filename '~/.zshrc'
autoload -Uz compinit
if [ "$(date +'%j')" != "$(stat -f '%Sm' -t '%j' ~/.zcompdump 2>/dev/null)" ]; then
    compinit
else
    compinit -C
fi
# End of lines added by compinstall

export NVM_DIR="$HOME/.nvm"
[ -s "$HOMEBREW_PREFIX/opt/nvm/nvm.sh" ] && \. "$HOMEBREW_PREFIX/opt/nvm/nvm.sh"  # This loads nvm
[ -s "$HOMEBREW_PREFIX/opt/nvm/etc/bash_completion.d/nvm" ] && \. "$HOMEBREW_PREFIX/opt/nvm/etc/bash_completion.d/nvm"  # This loads nvm bash_completion

export STARSHIP_CONFIG=~/Dev/dotfiles/starship.toml
eval "$(starship init zsh)"
# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=(/Users/jakeschwartz/.docker/completions $fpath)
autoload -Uz compinit
compinit
# End of Docker CLI completions
